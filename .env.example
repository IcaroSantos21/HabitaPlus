# Copie para .env. Nunca versione o .env.
# Usuário usado para acessar o banco de dados.
DB_USER=habita
# Senha do usuário do banco; troque este valor no arquivo .env.
DB_PASSWORD=troque_esta_senha
# Nome do banco de dados da aplicação.
DB_NAME=habitaplus
# Porta em que o banco de dados está disponível.
DB_PORT=5432

# Porta em que o servidor principal da aplicação será iniciado.
BACKEND_PORT=3000
# Porta em que o serviço de aprendizado de máquina será iniciado.
ML_PORT=8000
# Origem permitida para acessar a API pelo navegador; descomente e ajuste se necessário.
# CORS_ORIGIN=http://localhost:5173