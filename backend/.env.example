# Ambiente, porta do servidor e endereço permitido para chamadas do navegador.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT_SECRET deve ser uma chave aleatória longa; expiração em segundos.
JWT_SECRET=troque_por_uma_chave_aleatoria_longa
JWT_EXPIRES_IN_SECONDS=3600

# Dados de conexão com o PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=habita
DB_PASSWORD=troque_esta_senha
DB_NAME=habitaplus

# Chaves de teste do Stripe. Consulte ../docs/stripe-teste.md para obtê-las.
# O backend carrega o .env da raiz do repositório; coloque os valores lá também.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=